{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Homeroom",
  "version": "1.0.0",
  "identifier": "dev.homeroom.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Homeroom", "width": 1280, "height": 820, "minWidth": 880, "minHeight": 620 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
